#   git clone --depth 1 https://github.com/adaptyvbio/binder-prescreen tools/binder-prescreen
#   cd tools/binder-prescreen && uv venv && uv pip install -e .   # plus: brew install mmseqs2
tools/binder-prescreen/
# mmseqs intermediates from that run; report.csv / report.json are the artifacts.
