#!/usr/bin/env python3
"""Run a command in its OWN session, so it survives the launching shell's death.

macOS has no setsid(1). A run launched from a Claude Code session is a child of that
session's shell, and the session restarting (/login, a crash, a new session) kills the
whole process group. That killed three BoltzGen arms mid-run on 2026-10-02 at 12:20 --
all three logs stop within 9 seconds, no traceback -- and BoltzGen writes results back
only at the END, so 13 minutes x 3 H100 produced nothing.

usage: detach <logfile> <command> [args...]
Prints the detached pid. Env vars pass through, so GPU=/TIMEOUT= still work.
"""
import os, sys

if len(sys.argv) < 3:
    sys.exit(__doc__)
log, cmd = sys.argv[1], sys.argv[2:]

if os.fork():
    sys.exit(0)            # parent returns immediately

os.setsid()                # new session: no controlling terminal, new process group
fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
null = os.open(os.devnull, os.O_RDONLY)
os.dup2(null, 0); os.dup2(fd, 1); os.dup2(fd, 2)
os.execvp(cmd[0], cmd)
