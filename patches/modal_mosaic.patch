+
+    # --- the one loss term the whole programme has failed to control -----------------
+    class AcidNearHis(LossTerm):
+        """Pull a binder carboxylate to within d0 of the anchor histidine's ring N.
+
+        Measured on CA, not on OD1/OD2: design features give the binder UNK/G reference
+        atoms, so the binder has NO SIDECHAINS during optimization (mosaic README). CA to
+        ring-N is the honest differentiable proxy -- an Asp CA can sit at most ~3.9 A from
+        its own carboxylate O, so d0=8.0 is the CA distance consistent with O within 4.0 A.
+        The real all-atom distance is measured after design by _geometry() on a
+        re-prediction, and that is the number the gate sees.
+
+        Shape is (acid probability at i) x sigmoid((d0 - d_i)/width), summed over i and
+        logged: smooth, rewards one well-placed carboxylate, and does not care which
+        position wins.
+        """
+        his_token: int
+        d_idx: int
+        e_idx: int
+        d0: float = 8.0
+        width: float = 1.5
+        eps: float = 1e-3
+
+        def __call__(self, sequence, output, key):
+            L = sequence.shape[0]
+            ca = output.atom37_coords[:L, A37["CA"]]
+            nd1 = output.atom37_coords[self.his_token, A37["ND1"]]
+            ne2 = output.atom37_coords[self.his_token, A37["NE2"]]
+            d = jnp.minimum(
+                jnp.linalg.norm(ca - nd1, axis=-1), jnp.linalg.norm(ca - ne2, axis=-1)
+            )
+            # CLIP IS LOAD-BEARING, do not remove it. APGM evaluates the loss at the
+            # extrapolated point `x + momentum*(x - x_prev)`, which is OFF the simplex:
+            # entries there can be negative or exceed 1. Unclipped, `score` could go
+            # negative, `total + eps` could reach <= 0, and `log` of a non-positive number
+            # is NaN -- which is exactly what happened on 5 of 180 steps in tune01 (2.8%),
+            # each one discarded by APGM's own NaN guard. The earlier comment here claimed
+            # clipping the loss "would flatten its gradient"; that was wrong in the way
+            # that matters. Clipping to [0,1] only zeroes this term's gradient at points
+            # that are not valid probability vectors. Inside the simplex -- where every
+            # real sequence lives -- the gradient is untouched.
+            acid = jnp.clip(
+                sequence[:, self.d_idx] + sequence[:, self.e_idx], 0.0, 1.0
+            )
+            score = acid * jax.nn.sigmoid((self.d0 - d) / self.width)
+            total = score.sum()
+            # `eps` sets how hard this term pushes when no carboxylate is placed at all:
+            # the loss maxes out at -log(eps), so 1e-3 peaks near 6.9 with a gradient of
+            # ~1000, and 0.1 peaks near 2.3. Left at 1e-3 so tune01 stays the comparable
+            # baseline; it is a parameter now so it can be swept deliberately instead of
+            # being changed by accident.
+            loss = -jnp.log(total + self.eps)
+            return loss, {
+                "acid_his": loss,
+                "acid_best": score.max(),
+                "acid_dmin_CA": jnp.min(d + (1.0 - acid) * 100.0),
+            }
+
+    class HisNearCation(LossTerm):
+        """Problem 2's MIRROR of AcidNearHis: pull a binder HISTIDINE to the target's cation.
+
+        Problem 1 placed a binder carboxylate against a TARGET histidine (EGFR H433). Problem 2
+        inverts the roles -- the titratable group moves to the BINDER and the target supplies a
+        fixed positive charge (TNF R108 or K166). Same shape, same clipping, same eps semantics;
+        only the two chemistries swap sides.
+
+        MEASURED ON CA, for the reason AcidNearHis gives: design features hand the binder UNK/G
+        reference atoms, so it has NO SIDECHAINS during optimization. CA-to-cation-N is the
+        honest differentiable proxy. A histidine CA sits at most ~3.4 A from its own ND1, so
+        d0 = 6.5 is the CA distance consistent with ND1 within ~3.1 A -- which is the geometry
+        s6d measured as reachable and s9 measured as the one the cation actually acts on.
+        The real all-atom distance is measured after design by _geometry() on a re-prediction.
+
+        WHY THIS TERM IS WORTH HAVING EVEN THOUGH THE FILTERS ARE DEAD. s19/s20 retired
+        dddG_elec and his_cation_gate as SELECTORS -- they cannot rank finished molecules. That
+        is a different job from supplying a GRADIENT. Nothing measured says the geometry is
+        unbuildable; s6d says the opposite (17.2% of approach directions are clear at K166).
+        A filter must discriminate among molecules that exist; a loss only has to point
+        downhill. s22 and s20 together mean both conditional objectives must now be DESIGNED
+        IN rather than selected for, and this is the only place in the pipeline where that can
+        happen for the pH mechanism.
+
+        🔴 REDUCTION IS top-k, NOT sum -- and this is a correction, not a preference. The
+        first version wrote `total = score.sum()`, mirroring AcidNearHis. Summing rewards
+        total histidine MASS in the neighbourhood rather than histidine PLACEMENT, and the
+        cheapest way down that gradient is to put histidine everywhere. The 5-step trimer
+        smoke returned 12 histidines in 76 residues -- 15.8% against a ~2.3% natural
+        frequency -- while `his_best` sat at exactly 0.00 every step, i.e. the loss fell the
+        whole way without ONE histidine ever being placed. Arithmetic on the sigmoid confirms
+        the incentive without needing a run: 12 histidines loitering at 9.0 A score -0.646
+        under sum and 1 histidine placed at 3.0 A scores +0.091, so sum strictly PREFERS the
+        spam. Under top-2 the same two cases are +1.143 and +0.091 and the placed histidine
+        wins. k = 2 rather than 1 because s24 measured 0.40 pKa units per site, so the ratio
+        arithmetic needs two sites and a max would pay for only one.
+
+        AcidNearHis still sums, and has the same structural incentive. It is left alone
+        deliberately: problem 1's submitted set came from BoltzGen/MPNN with point mutations,
+        never from a Mosaic trajectory, so nothing shipped is affected -- and problem 1 is
+        another session's. Flagged in challenges/01, not fixed here.
+        """
+        his_idx: int
+        cation_atoms: tuple
+        d0: float = 6.5
+        width: float = 1.5
+        eps: float = 1e-3
+        topk: int = 2
+
+        def __call__(self, sequence, output, key):
+            L = sequence.shape[0]
+            ca = output.atom37_coords[:L, A37["CA"]]
+            ds = [jnp.linalg.norm(ca - output.atom37_coords[self.his_idx, A37[a]], axis=-1)
+                  for a in self.cation_atoms]
+            d = ds[0]
+            for extra in ds[1:]:
+                d = jnp.minimum(d, extra)
+            # Clip for the same reason AcidNearHis clips: APGM evaluates at an extrapolated
+            # point off the simplex, where an entry can be negative or exceed 1, and an
+            # unclipped score can drive log() to NaN. Inside the simplex the gradient is
+            # untouched.
+            his = jnp.clip(sequence[:, TOKENS.index("H")], 0.0, 1.0)
+            score = his * jax.nn.sigmoid((self.d0 - d) / self.width)
+            total = his_reduce(score, self.topk, jnp)   # top-k, not sum -- see the docstring
+            loss = -jnp.log(total + self.eps)
+            return loss, {
+                "his_cation": loss,
+                "his_best": score.max(),
+                "his_topk": total,
+                "frac_H": his.mean(),
+                "his_dmin_CA": jnp.min(d + (1.0 - his) * 100.0),
+            }
+
+    class CompositionCap(LossTerm):
+        """Hinge penalty on over-represented residues. Zero until the cap is crossed."""
+        caps: tuple
+        name: str = "comp"
+
+        def __call__(self, seq, *, key):
+            total, aux = 0.0, {}
+            for token_idx, cap, label in self.caps:
+                frac = seq[:, token_idx].mean()
+                total = total + jax.nn.relu(frac - cap)
+                aux[f"f_{label}"] = frac
+            return total, {self.name: total, **aux}
+
+    model = Boltz2()
+    mpnn = None
+    if use_mpnn:
+        # The published Nipah-winning recipe is Boltz-2 + SOLUBLE ProteinMPNN +
+        # simplex_APGM, and InverseFoldingSequenceRecovery is the term mosaic credits with
+        # raising filter pass rates. Optional and non-fatal: if the weights will not load
+        # the run continues without it rather than dying 20 minutes in.
+        try:
+            from mosaic.losses.protein_mpnn import InverseFoldingSequenceRecovery
+            from mosaic.proteinmpnn.mpnn import load_mpnn_sol
+            mpnn = load_mpnn_sol(0.0)
+            print("[mosaic] soluble ProteinMPNN loaded")
+        except Exception as e:
+            print(f"[mosaic] WARNING: ProteinMPNN unavailable ({type(e).__name__}: {e}); "
+                  "continuing without InverseFoldingSequenceRecovery")
+            mpnn = None
+
+    # One TargetChain per protomer, each carrying ITS OWN crystal chain as a template. The
+    # order here must match the order `offsets` was built in, or every index above is wrong.
+    target_chain_specs = [
+        TargetChain(sequence=seq_i, use_msa=False, template_chain=ch_i)
+        for _cid, ch_i, seq_i, _idx, _rn in chains_prepared
+    ]
+    target_chain_spec = target_chain_specs[0]      # kept for the re-prediction path below
+    species_chain_specs = [
+        TargetChain(sequence=seq_i, use_msa=False, template_chain=ch_i)
+        for _cid, ch_i, seq_i, _idx, _rn in (MO["chains_prepared"] if MO else [])
+    ]
+    # use_msa=False -> `msa: empty`, so nothing reaches an MSA server from inside Modal.
+    # The crystal chain goes in as a TEMPLATE instead, which is the stronger constraint
+    # here anyway: the whole design depends on H433's ring sitting where 6ARU puts it.
+
+    caps = tuple(
+        (TOKENS.index(aa), cap, aa)
+        for aa, cap in (("V", cap_val), ("G", cap_gly), ("H", cap_his)) if cap < 1.0
+    )
+    rows, files = [], {}
+
+    for L in length_list:
+        features, writer = model.binder_features(
+            binder_length=L, chains=target_chain_specs
+        )
+        inner = (
+            w_iptm * sp.BinderTargetIPTM()
+            + w_pae * sp.BinderTargetPAE()
+            + w_contact * sp.BinderTargetContact(
+                epitope_idx=epitope_idx, contact_distance=14.0, paratope_size=8
+            )
+            + w_within * sp.WithinBinderContact()
+            + w_plddt * sp.PLDDTLoss()
+            + w_glob * sp.ESMFoldGlobularity()
+            + w_acid * (AcidNearHis(
+                his_token=L + anchor_local,
+                d_idx=TOKENS.index("D"),
+                e_idx=TOKENS.index("E"),
+                d0=acid_d0,
+                width=acid_width,
+                eps=acid_eps,
+            ) if mechanism == "acid_near_his" else HisNearCation(
+                his_idx=L + anchor_local,
+                cation_atoms=(ARG_CATION_N if anchor_aa == "R" else LYS_CATION_N),
+                d0=his_d0,
+                width=acid_width,
+            ))
+        )
+        if mpnn is not None:
+            inner = inner + w_mpnn * InverseFoldingSequenceRecovery(
+                mpnn, temp=jnp.array(0.01)
+            )
+        total_loss = model.build_loss(
+            loss=inner, features=features,
+            recycling_steps=recycling_steps, sampling_steps=sampling_steps,
+        )
+        # GATE 0 -- THE MONOMER LOSS. tune01 produced binder pLDDT 0.41-0.52, barely above
+        # the 0.32-0.45 range of the resequencing arms that were written off as not folding.
+        # The likely cause: every term above sees only the COMPLEX, so nothing ever asks
+        # whether the binder folds ON ITS OWN. A binder can borrow structure from the target
+        # in a complex prediction and have no fold of its own. Both the mosaic README's
+        # worked example and the published Nipah recipe predict the binder alone as a second
+        # loss, with `chains=[]`.
+        #
+        # Costs a second Boltz-2 forward+backward per step, but on L residues instead of
+        # L + 170, so the step time should rise by much less than double.
+        #
+        # Set --w-monomer 0 to disable and reproduce tune01 exactly.
+        # SPECIES LEG (objective 2). Mirrors the monomer leg's pattern: a second
+        # build_loss over its own features, added with a weight. It carries the BINDING terms
+        # and the pH term, not the folding terms -- PLDDTLoss/globularity/WithinBinderContact
+        # are properties of the binder alone and the human leg plus the monomer leg already
+        # constrain them, so repeating them here would triple-count folding and quietly
+        # outvote the two objectives this leg exists to add.
+        #
+        # The pH term is included because the anchor is CONSERVED (R in both species, checked
+        # above and asserted), so one histidine can satisfy both; omitting it would let the
+        # optimiser place a histidine that works on human geometry alone.
+        #
+        # Cost: a third Boltz-2 forward+backward per step. Measured human-only is 21.7 s/step
+        # at 532 tokens; this leg is ~312 tokens more, so expect roughly 2.5x, not 2x.
+        if MO is not None and w_species > 0:
+            species_features, _ = model.binder_features(
+                binder_length=L, chains=species_chain_specs
+            )
+            species_inner = (
+                w_iptm * sp.BinderTargetIPTM()
+                + w_pae * sp.BinderTargetPAE()
+                + w_contact * sp.BinderTargetContact(
+                    epitope_idx=MO["epitope_idx"], contact_distance=14.0, paratope_size=8
+                )
+                + w_acid * HisNearCation(
+                    his_idx=L + MO["anchor_local"],
+                    cation_atoms=(ARG_CATION_N if MO["anchor_aa"] == "R" else LYS_CATION_N),
+                    d0=his_d0,
+                    width=acid_width,
+                )
+            )
+            total_loss = total_loss + w_species * model.build_loss(
+                loss=species_inner, features=species_features,
+                recycling_steps=recycling_steps, sampling_steps=sampling_steps,
+            )
+        if w_monomer > 0:
+            mono_features, _ = model.binder_features(binder_length=L, chains=[])
+            total_loss = total_loss + w_monomer * model.build_loss(
+                loss=sp.PLDDTLoss()
+                + sp.WithinBinderContact()
+                + sp.ESMFoldGlobularity(),
+                features=mono_features,
+                recycling_steps=recycling_steps,
+                sampling_steps=sampling_steps,
+            )
+        if caps:
+            total_loss = total_loss + w_comp * CompositionCap(caps=caps)
+        loss_fn = NoCys(loss=total_loss)      # Cys removed from the alphabet entirely
+        term_names = loss_term_names(loss_fn)
+        model_names = ["Boltz2"] + (["ProteinMPNN_soluble"] if mpnn is not None else [])
+        c1_violations = audit_c1(term_names, model_names)
+        if c1_violations:
+            raise SystemExit("STEP 4 FAILED on C1:\n  " + "\n  ".join(c1_violations))
+        print(f"[mosaic] C1 audit clean. loss terms: {', '.join(term_names)}")
+        step = stepsize if stepsize > 0 else 0.1 * float(np.sqrt(L))
+        print(f"[mosaic] L={L} stepsize={step:.3f} epitope={len(epitope_idx)} "
+              f"terms={'+mpnn' if mpnn else 'no-mpnn'}")
+
+        for s in range(n_seeds):
+            seed = seed0 + s
+            tag = f"{run_name}_L{L}_s{seed}"
+            key = jax.random.key(seed)
+            x = jax.nn.softmax(
+                0.5 * jax.random.gumbel(key=key, shape=(L, len(TOKENS) - 1))
+            )
+            # Two stages: soft to find a basin, then scale>1 to drive it discrete. One
+            # stage at scale>1 commits to a bad basin early; one at scale=1 never
+            # discretizes and the argmax then has little to do with what was optimized.
+            _, x = simplex_APGM(loss_function=loss_fn, x=x, n_steps=steps_soft,
+                                stepsize=step, momentum=0.9, scale=1.0,
+                                key=jax.random.fold_in(key, 1))
+            _, x = simplex_APGM(loss_function=loss_fn, x=x, n_steps=steps_sharp,
+                                stepsize=step, momentum=0.5, scale=sharpen,
+                                key=jax.random.fold_in(key, 2))
+            pssm = NoCys.sequence(x)                     # reinsert the zeroed Cys column
+            tokens = np.asarray(pssm).argmax(-1)
+            seq = "".join(TOKENS[int(i)] for i in tokens)
+            comp = {aa: seq.count(aa) / L for aa in set(seq)}
+            print(f"[mosaic] {tag} {seq}")
+
+            onehot = jax.nn.one_hot(jnp.array(tokens), len(TOKENS))
+            pred = model.predict(
+                PSSM=onehot, features=features, writer=writer,
+                recycling_steps=max(recycling_steps, 3), sampling_steps=25,
+                key=jax.random.key(seed),
+            )
+            # Re-predict with target-only features for BOTH chains: design features give
+            # the binder no sidechains, so the real carboxylate-O geometry and anything
+            # PROPKA touches can only be measured on an all-atom re-prediction.
+            re_features, re_writer = model.target_only_features(
+                [TargetChain(sequence=seq, use_msa=False)] + target_chain_specs
+            )
+            repred = model.predict(
+                features=re_features, writer=re_writer,
+                recycling_steps=3, sampling_steps=25, key=jax.random.key(seed),
+            )
+            # repred was predicted WITHOUT a PSSM, so mosaic's predict() hands IPTMLoss a
+            # zero-length sequence: asym_id becomes all-ones, every pair is masked out, and
+            # `repred.iptm` is exactly 0.0 for ANY design. That is an artifact of the call,
+            # not a property of the binder -- the same class of error as reading a pH switch
+            # off an apo reference. Read the interface off chain_pair_iptm() instead, which
+            # takes asym_id from the output and needs no binder sequence passed in.
+            pair_iptm = repred.model_output.chain_pair_iptm()
+            iptm_repred = float(pair_iptm.get((0, 1), float("nan")))
+            st = repred.model_output.to_structure()
+            # Renumber into POSITIONAL so the gates and the pose-check motif line up:
+            # binder chain A 1..L, target chain B carrying its positional numbers.
+            # MULTI-CHAIN renumbering. Chain 0 is the binder; chains 1..n are the protomers in
+            # the SAME ORDER as chains_prepared, which is the order target_chain_specs was built
+            # in. This block previously assumed exactly two chains and referenced a `resnums`
+            # that the multi-chain rewrite had deleted -- a NameError that only fired after the
+            # design finished and the re-prediction began, i.e. after the GPU time was spent.
+            m = st[0]
+            want = [L] + [len(rn) for *_rest, rn in chains_prepared]
+            got = [len(c) for c in m]
+            if got != want:
+                raise SystemExit(
+                    f"STEP 4 FAILED: re-prediction chains are {got}, expected {want} "
+                    f"-- do not renumber blind"
+                )
+            names = ["A"] + [chr(ord("B") + i) for i in range(len(chains_prepared))]
+            for c, nm in zip(m, names):
+                c.name = nm
+            for i, r in enumerate(m[0]):
+                r.seqid = gemmi.SeqId(i + 1, " ")
+            for chain_obj, (*_rest, rn) in zip(list(m)[1:], chains_prepared):
+                for r, num in zip(chain_obj, rn):
+                    r.seqid = gemmi.SeqId(num, " ")
+            st.setup_entities()
+            geom = (_geometry(st, anchor) if mechanism == "acid_near_his"
+                    else _geometry_p2(st, anchor))
+            row = {
+                "design": tag, "length": L, "seed": seed, "sequence": seq,
+                "iptm_design": round(float(pred.iptm), 4),
+                "plddt_binder_design": round(float(np.asarray(pred.plddt)[:L].mean()), 4),
+                "iptm_repred": round(iptm_repred, 4),
+                "plddt_binder_repred": round(float(np.asarray(repred.plddt)[:L].mean()), 4),
+                "frac_V": round(comp.get("V", 0.0), 3),
+                "frac_G": round(comp.get("G", 0.0), 3),
+                "n_C": seq.count("C"),
+                **geom,
+            }
+            gate_geometry(row)        # D-P2-1, before the audit so the audit sees the verdict
+            # The audit must never be the thing that destroys a design it was added to
+            # protect. By this point the GPU work for this design is already paid for, so
+            # a bug in ~40 lines of pure Python cannot be allowed to take it down. The C1
+            # audit above stays fatal on purpose: that one runs BEFORE any compute.
+            try:
+                violations = check_row(row, L)
+            except Exception as e:
+                violations = [f"the metric audit itself raised {type(e).__name__}: {e}"]
+            row["metrics_ok"] = not violations
+            rows.append(row)
+            print(f"[mosaic] {tag} {json.dumps(geom)} iptm={row['iptm_repred']}")
+            if violations:
+                # Loud, and recorded in the row, but NOT fatal: the designs and the
+                # structures are still worth keeping. What must never happen is a bad
+                # number travelling downstream looking like a good one.
+                print(f"[mosaic] 🔴 {tag} METRICS SUSPECT -- do not rank on this row:")
+                for v in violations:
+                    print(f"[mosaic]      {v}")
+            files[f"complex/{tag}.pdb"] = st.make_pdb_string().encode()
+            files[f"pssm/{tag}.npy"] = np.asarray(pssm).astype(np.float32).tobytes()
+
+    files["designs.faa"] = "".join(
+        f">{r['design']}\n{r['sequence']}\n" for r in rows
+    ).encode()
+    cols = list(rows[0].keys()) if rows else []
+    files["designs.tsv"] = (
+        "\t".join(cols) + "\n"
+        + "".join("\t".join("" if r[c] is None else str(r[c]) for c in cols) + "\n" for r in rows)
+    ).encode()
+    files["numbering.json"] = json.dumps({
+        "scheme": "positional in egfr_ecd_6aru_renum.pdb, contiguous 1..609, "
+                  "positional = canonical - 27",
+        "written_pdbs": "binder = chain A, 1..L; target = chain B, positional numbering",
+        "anchor": {"positional": anchor, "canonical": anchor + 27, "label": "H433"},
+        "epitope_positional": epitope_pos,
+        "crop": list(crop_t) if crop_t else None,
+        "ph_gate_note": "bin/ph_gate_target_his.py CANON is BoltzGen-output numbering "
+                        f"(H433 -> 409). For these files it must be {{{anchor}: 'H433'}}.",
+    }, indent=2).encode()
+    files["config.json"] = json.dumps({
+        "crop": crop, "epitope": epitope, "anchor": anchor, "lengths": lengths,
+        "n_seeds": n_seeds, "seed0": seed0, "steps_soft": steps_soft,
+        "steps_sharp": steps_sharp, "recycling_steps": recycling_steps,
+        "sampling_steps": sampling_steps, "stepsize": stepsize, "sharpen": sharpen,
+        "use_mpnn": mpnn is not None, "smoke": smoke,
+        "weights": {"iptm": w_iptm, "pae": w_pae, "contact": w_contact,
+                    "within": w_within, "plddt": w_plddt, "glob": w_glob,
+                    "acid": w_acid, "mpnn": w_mpnn, "comp": w_comp,
+                    "monomer": w_monomer},
+        "caps": {"V": cap_val, "G": cap_gly, "H": cap_his}, "acid_d0": acid_d0,
+        "acid_width": acid_width, "acid_eps": acid_eps,
+        # Derived from the composed loss object, not asserted. The previous value here
+        # was a hardcoded `True` that would have printed True with ipSAE in the loss.
+        "loss_terms": term_names, "design_models": model_names,
+        "c1_audit": "clean" if not audit_c1(term_names, model_names) else "VIOLATION",
+    }, indent=2).encode()
+
+    out = Path("/weights/runs") / run_name
+    for rel, content in files.items():
+        p = out / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_bytes(content)
+    weights.commit()
+    print(f"[mosaic] {len(rows)} designs; also written to {out} on the Volume")
+    passed = [r for r in rows if r.get("geometry_pass")]
+    suspect = [r["design"] for r in rows if not r.get("metrics_ok", True)]
+    anchor_label = f"{anchor_aa}{anchor} on chain {anchor_chain}"
+    # Name the anchor that was actually used. This line read "of H433" unconditionally --
+    # problem 1's EGFR histidine -- so the first passing problem 2 trimer run reported a
+    # correct distance against the wrong residue name. A log line that names the wrong
+    # anchor is how a number gets believed about the wrong molecule later.
+    # Two DIFFERENT questions, and this line used to blur them: did step 4 produce rows, and
+    # did any design place its titratable residue? It printed "STEP 4 PASSED: 0/1", which a
+    # reader scanning for PASSED takes as success when in fact no design passed geometry.
+    # Completion is reported as RAN/FAILED; geometry gets its own verdict line.
+    print(f"[mosaic] STEP 4 {'RAN' if rows else 'FAILED - no designs'}: {len(rows)} designs")
+    if rows:
+        read = [r for r in rows if r.get("geometry_read")]
+        if not read:
+            # D-P2-1: every design is below the iptm bar, so "0 passed" would be a false
+            # negative -- nothing was measured. Say that instead.
+            print(f"[mosaic] ⬛ GEOMETRY n/a on all {len(rows)} designs: none reached "
+                  f"iptm_repred {GEOMETRY_IPTM_BAR} (D-P2-1), so placement was never "
+                  f"measurable. This is NOT a geometry failure.")
+        else:
+            print(f"[mosaic] {'✅' if passed else '🔴'} GEOMETRY {len(passed)}/{len(read)} "
+                  f"within 4.0 A of {anchor_label}"
+                  + ("" if passed else " -- NO design placed its histidine")
+                  + (f"; {len(rows) - len(read)} more n/a below the iptm bar"
+                     if len(read) != len(rows) else ""))
+    if suspect:
+        print(f"[mosaic] 🔴 {len(suspect)}/{len(rows)} rows have SUSPECT METRICS: "
+              f"{', '.join(suspect)} -- see metrics_ok in designs.tsv")
+    else:
+        print(f"[mosaic] metrics audit clean on all {len(rows)} rows")
+    return [(rel, content) for rel, content in files.items()]
+
+
+@app.local_entrypoint()
+def main(
+    step: int = 1,
+    target: str = "../targets/egfr/egfr_ecd_6aru_renum.pdb",
+    target_chain: str = "A",
+    anchor_chain: str = "A",
+    target2: str = "",
+    target2_chain: str = "A,B",
+    target2_epitope: str = "",
+    target2_anchor: int = 0,
+    target2_anchor_chain: str = "A",
+    w_species: float = 1.0,
+    run_name: str = "",
+    out_dir: str = "../runs/mosaic",
+    crop: str = "284:453",
+    epitope: str = DEFAULT_EPITOPE,
+    anchor: int = ANCHOR,
+    lengths: str = "76",
+    n_seeds: int = 2,
+    seed0: int = 0,
+    steps_soft: int = 60,
+    steps_sharp: int = 40,
+    recycling_steps: int = 1,
+    sampling_steps: int = 10,
+    stepsize: float = 0.0,
+    sharpen: float = 1.3,
+    use_mpnn: bool = True,
+    w_acid: float = 2.0,
+    w_mpnn: float = 3.0,
+    w_plddt: float = 1.0,
+    w_monomer: float = 0.5,
+    cap_val: float = 0.12,
+    cap_gly: float = 0.08,
+    cap_his: float = 0.08,
+    acid_d0: float = 8.0,
+    his_d0: float = 6.5,
+    mechanism: str = "acid_near_his",
+    acid_eps: float = 1e-3,
+    smoke: bool = False,
+):
+    """Steps 1-3 are probes and take no arguments. Step 4 designs.
+
+    GPU=L40S modal run --detach modal_mosaic.py --step 4 --smoke --run-name smoke01
+    """
+    from datetime import datetime
+    from pathlib import Path
+
+    if step != 4:
+        print({1: probe, 2: probe_mosaic, 3: fetch_weights}[step].remote())
+        return
+
+    pdb = Path(target)
+    if not pdb.is_file():
+        raise SystemExit(f"target not found: {pdb.resolve()}  (paths resolve from biomodals/)")
+    # Read the species target HERE, on the laptop, and fail before paying for a container.
+    target2_bytes = b""
+    if target2:
+        p2 = Path(target2)
+        if not p2.is_file():
+            raise SystemExit(f"--target2 not found: {p2.resolve()}  "
+                             f"(paths resolve from biomodals/)")
+        target2_bytes = p2.read_bytes()
+    run = run_name or datetime.now().strftime("%y%m%d%H%M")
+    results = design.remote(
+        target_pdb=pdb.read_bytes(), run_name=run, crop=crop, epitope=epitope,
+        target_chain=target_chain, anchor_chain=anchor_chain,
+        target2_pdb=target2_bytes, target2_chain=target2_chain,
+        target2_epitope=target2_epitope, target2_anchor=target2_anchor,
+        target2_anchor_chain=target2_anchor_chain, w_species=w_species,
+        anchor=anchor, lengths=lengths, n_seeds=n_seeds, seed0=seed0,
+        steps_soft=steps_soft, steps_sharp=steps_sharp,
+        recycling_steps=recycling_steps, sampling_steps=sampling_steps,
+        stepsize=stepsize, sharpen=sharpen, use_mpnn=use_mpnn, w_acid=w_acid,
+        w_mpnn=w_mpnn, w_plddt=w_plddt, w_monomer=w_monomer,
+        cap_val=cap_val, cap_gly=cap_gly, cap_his=cap_his, acid_d0=acid_d0, acid_eps=acid_eps,
+        his_d0=his_d0, mechanism=mechanism,
+        smoke=smoke,
+    )
+    dest = Path(out_dir) / run
+    for rel, content in results:
+        p = dest / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_bytes(content)
+    print(f"\nResults saved to: {dest}")
