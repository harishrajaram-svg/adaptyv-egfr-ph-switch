+                             "--target2-anchor. They are NOT the human numbers: a deletion "
+                             "near human positional 68 shifts the register (-3 at the anchor, "
+                             "-4 further along). See analysis/02-tnf/epitope_conserved.json.")
+        epi2 = [int(v) for v in target2_epitope.split(",")]
