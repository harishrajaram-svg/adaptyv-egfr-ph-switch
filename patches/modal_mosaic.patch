+            )
+            repred = model.predict(
+                features=re_features, writer=re_writer,
+                recycling_steps=3, sampling_steps=25, key=jax.random.key(seed),
+            )
+            # repred was predicted WITHOUT a PSSM, so mosaic's predict() hands IPTMLoss a
+            # zero-length sequence: asym_id becomes all-ones, every pair is masked out, and
+            # `repred.iptm` is exactly 0.0 for ANY design. That is an artifact of the call,
+            # not a property of the binder -- the same class of error as reading a pH switch
+            # off an apo reference. Read the interface off chain_pair_iptm() instead, which
+            # takes asym_id from the output and needs no binder sequence passed in.
+            pair_iptm = repred.model_output.chain_pair_iptm()
+            iptm_repred = float(pair_iptm.get((0, 1), float("nan")))
+            st = repred.model_output.to_structure()
+            # Renumber into POSITIONAL so the gates and the pose-check motif line up:
+            # binder chain A 1..L, target chain B carrying its positional numbers.
+            m = st[0]
+            if len(m[0]) != L or len(m[1]) != len(resnums):
+                raise SystemExit(
+                    f"STEP 4 FAILED: re-prediction chains are {len(m[0])}/{len(m[1])}, "
+                    f"expected {L}/{len(resnums)} -- do not renumber blind"
+                )
+            m[0].name = "A"
+            m[1].name = "B"
+            for i, r in enumerate(m[0]):
+                r.seqid = gemmi.SeqId(i + 1, " ")
+            for r, num in zip(m[1], resnums):
+                r.seqid = gemmi.SeqId(num, " ")
+            st.setup_entities()
+            geom = (_geometry(st, anchor) if mechanism == "acid_near_his"
+                    else _geometry_p2(st, anchor))
+            row = {
+                "design": tag, "length": L, "seed": seed, "sequence": seq,
+                "iptm_design": round(float(pred.iptm), 4),
+                "plddt_binder_design": round(float(np.asarray(pred.plddt)[:L].mean()), 4),
+                "iptm_repred": round(iptm_repred, 4),
+                "plddt_binder_repred": round(float(np.asarray(repred.plddt)[:L].mean()), 4),
+                "frac_V": round(comp.get("V", 0.0), 3),
+                "frac_G": round(comp.get("G", 0.0), 3),
+                "n_C": seq.count("C"),
+                **geom,
+            }
+            # The audit must never be the thing that destroys a design it was added to
+            # protect. By this point the GPU work for this design is already paid for, so
+            # a bug in ~40 lines of pure Python cannot be allowed to take it down. The C1
+            # audit above stays fatal on purpose: that one runs BEFORE any compute.
+            try:
+                violations = check_row(row, L)
+            except Exception as e:
+                violations = [f"the metric audit itself raised {type(e).__name__}: {e}"]
+            row["metrics_ok"] = not violations
+            rows.append(row)
+            print(f"[mosaic] {tag} {json.dumps(geom)} iptm={row['iptm_repred']}")
+            if violations:
+                # Loud, and recorded in the row, but NOT fatal: the designs and the
+                # structures are still worth keeping. What must never happen is a bad
+                # number travelling downstream looking like a good one.
+                print(f"[mosaic] 🔴 {tag} METRICS SUSPECT -- do not rank on this row:")
+                for v in violations:
+                    print(f"[mosaic]      {v}")
+            files[f"complex/{tag}.pdb"] = st.make_pdb_string().encode()
+            files[f"pssm/{tag}.npy"] = np.asarray(pssm).astype(np.float32).tobytes()
+
+    files["designs.faa"] = "".join(
+        f">{r['design']}\n{r['sequence']}\n" for r in rows
+    ).encode()
+    cols = list(rows[0].keys()) if rows else []
+    files["designs.tsv"] = (
+        "\t".join(cols) + "\n"
+        + "".join("\t".join("" if r[c] is None else str(r[c]) for c in cols) + "\n" for r in rows)
+    ).encode()
+    files["numbering.json"] = json.dumps({
+        "scheme": "positional in egfr_ecd_6aru_renum.pdb, contiguous 1..609, "
+                  "positional = canonical - 27",
+        "written_pdbs": "binder = chain A, 1..L; target = chain B, positional numbering",
+        "anchor": {"positional": anchor, "canonical": anchor + 27, "label": "H433"},
+        "epitope_positional": epitope_pos,
+        "crop": list(crop_t) if crop_t else None,
+        "ph_gate_note": "bin/ph_gate_target_his.py CANON is BoltzGen-output numbering "
+                        f"(H433 -> 409). For these files it must be {{{anchor}: 'H433'}}.",
+    }, indent=2).encode()
+    files["config.json"] = json.dumps({
+        "crop": crop, "epitope": epitope, "anchor": anchor, "lengths": lengths,
+        "n_seeds": n_seeds, "seed0": seed0, "steps_soft": steps_soft,
+        "steps_sharp": steps_sharp, "recycling_steps": recycling_steps,
+        "sampling_steps": sampling_steps, "stepsize": stepsize, "sharpen": sharpen,
+        "use_mpnn": mpnn is not None, "smoke": smoke,
+        "weights": {"iptm": w_iptm, "pae": w_pae, "contact": w_contact,
+                    "within": w_within, "plddt": w_plddt, "glob": w_glob,
+                    "acid": w_acid, "mpnn": w_mpnn, "comp": w_comp,
+                    "monomer": w_monomer},
+        "caps": {"V": cap_val, "G": cap_gly}, "acid_d0": acid_d0,
+        "acid_width": acid_width, "acid_eps": acid_eps,
+        # Derived from the composed loss object, not asserted. The previous value here
+        # was a hardcoded `True` that would have printed True with ipSAE in the loss.
+        "loss_terms": term_names, "design_models": model_names,
+        "c1_audit": "clean" if not audit_c1(term_names, model_names) else "VIOLATION",
+    }, indent=2).encode()
+
+    out = Path("/weights/runs") / run_name
+    for rel, content in files.items():
+        p = out / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_bytes(content)
+    weights.commit()
+    print(f"[mosaic] {len(rows)} designs; also written to {out} on the Volume")
+    passed = [r for r in rows if r.get("geometry_pass")]
+    suspect = [r["design"] for r in rows if not r.get("metrics_ok", True)]
+    print(f"[mosaic] STEP 4 {'PASSED' if rows else 'FAILED - no designs'}: "
+          f"{len(passed)}/{len(rows)} within 4.0 A of H433")
+    if suspect:
+        print(f"[mosaic] 🔴 {len(suspect)}/{len(rows)} rows have SUSPECT METRICS: "
+              f"{', '.join(suspect)} -- see metrics_ok in designs.tsv")
+    else:
+        print(f"[mosaic] metrics audit clean on all {len(rows)} rows")
+    return [(rel, content) for rel, content in files.items()]
+
